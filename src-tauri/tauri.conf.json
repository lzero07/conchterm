{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConchTerm",
  "version": "0.1.0",
  "identifier": "com.lzero07.conchterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ConchTerm",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../agent/main.py": "agent/main.py",
      "../agent/providers.py": "agent/providers.py",
      "../agent/tools.py": "agent/tools.py",
      "../agent/requirements.txt": "agent/requirements.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
